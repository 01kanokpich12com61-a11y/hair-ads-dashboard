# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า
PORT=3000
# 127.0.0.1 = เปิดเฉพาะเครื่องตัวเอง / 0.0.0.0 = เปิดให้เครื่องอื่นเข้าได้ (ควรใช้หลัง HTTPS)
HOST=127.0.0.1

# บัญชีผู้ดูแล (สร้างอัตโนมัติครั้งแรกที่รัน)
ADMIN_USER=admin
# ถ้าไม่ตั้ง จะใช้รหัสเริ่มต้น admin1234 และระบบจะบังคับให้เปลี่ยนรหัสผ่าน
ADMIN_PASSWORD=

# ตั้งเป็น 1 เมื่อใช้งานผ่าน HTTPS
COOKIE_SECURE=0

# Meta Marketing API
META_API_VERSION=v25.0

# ตั้งเป็น 1 เมื่ออยู่หลัง reverse proxy (เพื่อให้ Audit บันทึก IP จริงของผู้ใช้)
TRUST_PROXY=0
